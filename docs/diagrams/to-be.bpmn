        <di:waypoint x="1020.0" y="275" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_9" bpmnElement="Flow_9">
        <di:waypoint x="1230" y="135.0" />
        <di:waypoint x="1265" y="135.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_10" bpmnElement="Flow_10">
        <di:waypoint x="1410" y="135.0" />
        <di:waypoint x="1445" y="135.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_11" bpmnElement="Flow_11">
        <di:waypoint x="1590" y="135.0" />
        <di:waypoint x="1630" y="135.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_12" bpmnElement="Flow_12">
        <di:waypoint x="1680" y="135.0" />
        <di:waypoint x="1795" y="135.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_13" bpmnElement="Flow_13">
        <di:waypoint x="1655.0" y="160" />
        <di:waypoint x="1655.0" y="275" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>