      <bpmndi:BPMNShape id="Shape_proposal" bpmnElement="Node_proposal">
        <dc:Bounds x="1085" y="100" width="145" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_follow_task" bpmnElement="Node_follow_task">
        <dc:Bounds x="1265" y="100" width="145" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_follow" bpmnElement="Node_follow">
        <dc:Bounds x="1445" y="100" width="145" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_decision" bpmnElement="Node_decision">
        <dc:Bounds x="1630" y="110" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_won" bpmnElement="Node_won">
        <dc:Bounds x="1795" y="117" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_not_fit" bpmnElement="Node_not_fit">
        <dc:Bounds x="1002" y="275" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_lost" bpmnElement="Node_lost">
        <dc:Bounds x="1637" y="275" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_1" bpmnElement="Flow_1">
        <di:waypoint x="61" y="135.0" />
        <di:waypoint x="90" y="135.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_2" bpmnElement="Flow_2">
        <di:waypoint x="235" y="135.0" />
        <di:waypoint x="270" y="135.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_3" bpmnElement="Flow_3">
        <di:waypoint x="415" y="135.0" />
        <di:waypoint x="450" y="135.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_4" bpmnElement="Flow_4">
        <di:waypoint x="595" y="135.0" />
        <di:waypoint x="630" y="135.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_5" bpmnElement="Flow_5">
        <di:waypoint x="775" y="135.0" />
        <di:waypoint x="810" y="135.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_6" bpmnElement="Flow_6">
        <di:waypoint x="955" y="135.0" />
        <di:waypoint x="995" y="135.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_7" bpmnElement="Flow_7">
