<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_as-is" targetNamespace="https://github.com/iwik1329/Pulse-crm/process">
  <bpmn:process id="Process_as-is" name="AS-IS · ручная обработка заявки" isExecutable="false">
    <bpmn:startEvent id="Node_start" name="Заявка" />
    <bpmn:task id="Node_receive" name="Прочитать входящую заявку" />
    <bpmn:task id="Node_spreadsheet" name="Внести данные в таблицу" />
    <bpmn:exclusiveGateway id="Node_assigned" name="Назначена?" />
    <bpmn:task id="Node_contact" name="Связаться с клиентом" />
    <bpmn:exclusiveGateway id="Node_answer" name="Ответил?" />
    <bpmn:task id="Node_offer" name="Подготовить и отправить КП" />
    <bpmn:exclusiveGateway id="Node_decision" name="Согласовано?" />
    <bpmn:endEvent id="Node_won" name="Успех" />
    <bpmn:endEvent id="Node_lost_assignment" name="Потеря заявки" />
    <bpmn:endEvent id="Node_lost_answer" name="Нет контроля повтора" />
    <bpmn:endEvent id="Node_lost_offer" name="Сделка не закрыта" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Node_start" targetRef="Node_receive" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Node_receive" targetRef="Node_spreadsheet" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Node_spreadsheet" targetRef="Node_assigned" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Node_assigned" targetRef="Node_contact" name="да" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Node_assigned" targetRef="Node_lost_assignment" name="нет" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Node_contact" targetRef="Node_answer" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Node_answer" targetRef="Node_offer" name="да" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Node_answer" targetRef="Node_lost_answer" name="нет" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Node_offer" targetRef="Node_decision" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Node_decision" targetRef="Node_won" name="да" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Node_decision" targetRef="Node_lost_offer" name="нет" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_as-is">
    <bpmndi:BPMNPlane id="Plane_as-is" bpmnElement="Process_as-is">
